@Pos.Api_HostAddress = http://localhost:5090

GET {{Pos.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

### 1) Sale by piece only
POST {{Pos.Api_HostAddress}}/api/invoices/finalize
Content-Type: application/json

{
  "cashierId": 1,
  "items": [
    { "productId": 5, "unitSold": "piece", "quantity": 3 }
  ]
}

###

### 2) Sale by package only
POST {{Pos.Api_HostAddress}}/api/invoices/finalize
Content-Type: application/json

{
  "cashierId": 1,
  "items": [
    { "productId": 5, "unitSold": "package", "quantity": 2 }
  ]
}

###

### 3) Same product sold as piece AND package in one invoice
### (must check stock against the SUM of both lines, not each line alone)
POST {{Pos.Api_HostAddress}}/api/invoices/finalize
Content-Type: application/json

{
  "cashierId": 1,
  "items": [
    { "productId": 5, "unitSold": "piece", "quantity": 1 },
    { "productId": 5, "unitSold": "package", "quantity": 1 }
  ]
}

###

### 4) Invalid discount (percentage over 100) -> should now return 400
### with the real FluentValidation message instead of a generic 500
POST {{Pos.Api_HostAddress}}/api/invoices/finalize
Content-Type: application/json

{
  "cashierId": 1,
  "items": [
    { "productId": 5, "unitSold": "piece", "quantity": 1 }
  ],
  "discountType": "percentage",
  "discountValue": 150
}

###

### 5) Empty invoice -> BR-01, should return 400
POST {{Pos.Api_HostAddress}}/api/invoices/finalize
Content-Type: application/json

{
  "cashierId": 1,
  "items": []
}

###

### 6) Exchange: swap invoice item #1 for a different product
### (adjust InvoiceItemId/ReplacementProductId to real seeded ids first)
POST {{Pos.Api_HostAddress}}/api/invoices/exchange
Content-Type: application/json

{
  "invoiceItemId": 1,
  "returnedQuantity": 1,
  "replacementProductId": 2,
  "replacementUnitSold": "piece",
  "replacementQuantity": 1,
  "processedBy": 1,
  "reason": "Wrong size"
}

###

### 7) Exchange rejected -> BR-09: user without 'process_return' permission
### should get 403 Forbidden, not a generic error
POST {{Pos.Api_HostAddress}}/api/invoices/exchange
Content-Type: application/json

{
  "invoiceItemId": 1,
  "returnedQuantity": 1,
  "replacementProductId": 2,
  "replacementUnitSold": "piece",
  "replacementQuantity": 1,
  "processedBy": 999,
  "reason": "Wrong size"
}

###
